<ScrollView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/pozadina">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="170dp">

        <ImageButton
            android:id="@+id/btnNatrag"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:src="@drawable/arrow_back_icon"
            android:scaleType="centerInside"
            tools:ignore="SpeakableTextPresentCheck" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:text="Uređivanje usluge"
            android:textColor="@color/crnoubijelo"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nazivUslugeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background_border"
            android:hint="Naziv usluge"
            android:padding="12dp"
            android:textColor="@color/crnoubijelo" />

        <EditText
            android:id="@+id/opisUslugeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background_border"
            android:gravity="top"
            android:hint="Opis usluge"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/crnoubijelo" />

        <EditText
            android:id="@+id/cijenaUslugeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background_border"
            android:hint="Cijena (€)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="@color/crnoubijelo" />

        <EditText
            android:id="@+id/trajanjeUslugeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_background_border"
            android:hint="Trajanje (min)"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/crnoubijelo" />

        <Button
            android:id="@+id/btnSpremiUslugu"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="@color/secondaryColor"
            android:padding="12dp"
            android:text="Spremi promjene"
            android:textColor="@color/crnoubijelo"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
