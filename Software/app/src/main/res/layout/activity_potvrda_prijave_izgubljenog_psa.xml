<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".f02_izgubljeni_pas.PotvrdaPrijaveIzgubljenogPsaActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPotvrdaIzgubljenogPsa"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@color/secondaryColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Potvrdi prijavu izgubljenog psa"
            android:textSize="25dp"
            android:textStyle="bold"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="120dp"
            app:layout_constraintBottom_toBottomOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintEnd_toEndOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintTop_toTopOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintVertical_bias="0.698" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarPotvrdaIzgubljenogPsa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbarPotvrdaIzgubljenogPsa">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slika psa:"
                android:textSize="22dp"
                android:textStyle="bold"
                android:layout_marginTop="40dp"
                android:layout_gravity="center" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/slikapsa"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="270dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:background="#CCCCCC" />
        </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uneseni dodatni opis psa:"
                android:textSize="22dp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:layout_gravity="center" />
            <TextView
                android:id="@+id/opisPsa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:gravity="center"
                android:textStyle="italic"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zadnje viđena lokacija:"
                android:textStyle="bold"
                android:textSize="22dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp" />

            <TextView
                android:id="@+id/zadnjalokacija"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:gravity="center"
                android:textStyle="italic"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center" />




            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp">

                <Button
                    android:id="@+id/odustaniGumb"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Odustani"
                    android:backgroundTint="@color/secondaryColor"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="20dp" />

                <Button
                    android:id="@+id/potvrdi"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="Potvrdi"
                    android:backgroundTint="@color/secondaryColor"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    android:layout_marginLeft="50dp"/>

            </LinearLayout>
        </LinearLayout>

    </ScrollView>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbarPotvrdaIzgubljenogPsa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.948"
        app:layout_constraintStart_toStartOf="@+id/toolbarPotvrdaIzgubljenogPsa"
        app:layout_constraintTop_toTopOf="@+id/toolbarPotvrdaIzgubljenogPsa"
        app:layout_constraintVertical_bias="0.16"
        app:srcCompat="@drawable/wanted" />


</androidx.constraintlayout.widget.ConstraintLayout>