<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/slikaProizvoda"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/test_slika" />

    <TextView
        android:id="@+id/nazivProizvoda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="152dp"
        android:text="Proizvod"
        android:textColor="@color/accentColor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="6dp"
        app:layout_constraintEnd_toStartOf="@id/btnObrisi"
        app:layout_constraintStart_toEndOf="@id/slikaProizvoda"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/kategorijaProizvoda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kategorija"
        android:textColor="@color/proizvodInfo"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/nazivProizvoda"
        app:layout_constraintTop_toBottomOf="@id/nazivProizvoda" />

    <TextView
        android:id="@+id/cijenaProizvoda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cijena"
        android:textSize="12sp"
        android:textColor="@color/proizvodInfo"
        app:layout_constraintStart_toStartOf="@id/nazivProizvoda"
        app:layout_constraintTop_toBottomOf="@id/kategorijaProizvoda" />

    <LinearLayout
        android:id="@+id/kontroleKolicine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="9dp"
        android:background="@drawable/kolicina_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnObrisi">

        <TextView
            android:id="@+id/btnSmanji"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/kosarica_dodavanje"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/accentColor"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/kolicinaBroj"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/accentColor"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPovecaj"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/kosarica_dodavanje"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/accentColor"
            android:textSize="20sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnObrisi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:padding="10px"
        android:text="OBRISI"
        android:textColor="@color/accentColor"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
