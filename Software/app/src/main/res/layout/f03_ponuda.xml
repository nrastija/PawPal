<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="300dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/promoPonuda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/promoponuda"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGenerirajKod"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="5dp"
                    android:backgroundTint="@color/primaryColor"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Iskoristi kod"
                    android:textColor="@color/crnoubijelo"
                    android:textSize="9sp"
                    app:cornerRadius="5dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/promoPonudaNaslov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="1dp"
                    android:fontFamily="@font/happymonkey"
                    android:gravity="right"
                    android:paddingRight="6dp"
                    android:text="Naslov"
                    android:textColor="@color/secondaryColor"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/promoPonudaOpis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="right"
                android:text="opis"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/promoPonudaDatum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="right"
                android:text="datumValjanosti"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/promoPonudaUvjeti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="uvjeti"
                android:gravity="right"
                android:textColor="@color/black"
                android:textSize="9sp" />

        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
