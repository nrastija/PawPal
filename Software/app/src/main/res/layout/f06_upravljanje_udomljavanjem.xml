<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/bijeloucrno"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="410dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/bijeloucrno"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/slikaPasCovjek"
                        android:layout_width="100dp"
                        android:layout_marginLeft="2dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pesek1" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/novinajboljiprijatelj"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pronađite svog novog najboljeg prijatelja!"
                            android:textColor="@color/accentColor"
                            android:textSize="20sp"
                            android:layout_marginRight="20dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/kontaktemail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="E-mail adresa: info@pawpal.com"
                            android:textColor="@color/accentColor"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/kontaktbrojtelefona"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Broj telefona: +385998752934"
                            android:textColor="@color/accentColor"
                            android:textStyle="bold"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/btnDodajPsa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dodaj psa" />

</LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPasUdomljavanje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
