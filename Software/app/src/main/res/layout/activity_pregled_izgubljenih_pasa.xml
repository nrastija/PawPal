<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".f02_izgubljeni_pas.PregledIzgubljenihPasaActivity">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPregled"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@color/secondaryColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="230dp"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:text="Pregled izgubljenih pasa"
            android:textSize="28dp"
            android:textStyle="bold"
            android:layout_marginLeft="90dp"
            app:layout_constraintBottom_toBottomOf="@+id/toolbarPregled"
            app:layout_constraintEnd_toEndOf="@+id/toolbarPregled"
            app:layout_constraintStart_toStartOf="@+id/toolbarPregled"
            app:layout_constraintTop_toTopOf="@+id/toolbarPregled" />
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="689dp"
        android:layout_marginTop="1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pozadina"
        app:layout_constraintVertical_bias="0.0">

    <FrameLayout
        android:layout_width="370dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginTop="38dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/zaobljeni_rubovi_kutije">

        <ImageView
            android:id="@+id/kutija1"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="80dp" />

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:layout_marginTop="15dp"
                android:textSize="26dp"
                android:layout_gravity="center"
                android:text="Ime psa:Darko" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:textSize="26dp"
                android:layout_gravity="center"
                android:text="Opis: veliki crni" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:textSize="26dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="Zadnje viđen: dubrava"/>

            <Button
                android:id="@+id/gumb1"
                android:layout_width="160dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primaryColor"
                android:textColor="@color/textColorPrimary"
                android:text="Odaberi"
                android:textSize="24dp"
                tools:ignore="TextContrastCheck" />

        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>