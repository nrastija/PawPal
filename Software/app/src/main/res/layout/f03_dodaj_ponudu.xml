<ScrollView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/primaryColor">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="270dp">

        <ImageButton
            android:id="@+id/btnNatrag"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:src="@drawable/arrow_back_icon"
            android:scaleType="centerInside"
            tools:ignore="SpeakableTextPresentCheck" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/ponudeSlika"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/pawpal2" />

            <TextView
                android:id="@+id/ponudeTekst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="17dp"
                android:layout_gravity="bottom|center_horizontal"
                android:text="Promo ponude"
                android:fontFamily="@font/happymonkey"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="20dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dodavanje nove ponude"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/crnoubijelo"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/nazivPonude"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Naziv ponude"
            android:inputType="text"
            android:background="@drawable/rounded_background_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/opisPonude"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Opis ponude"
            android:background="@drawable/rounded_background_border"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/datumValjanostiPonude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Datum valjanosti"
            android:background="@drawable/rounded_background_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/uvjetiPonude"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Uvjeti ponude"
            android:background="@drawable/rounded_background_border"
            android:padding="12dp"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSpremiPonudu"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/secondaryColor"
            android:padding="12dp"
            android:text="Spremi ponudu"
            android:textColor="@color/crnoubijelo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
