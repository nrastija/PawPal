<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="@color/accentColor" >

        <LinearLayout
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/shopServiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kupovina"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:padding="3dp"/>
        <TextView
            android:id="@+id/shopServiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datum: 30.03.2025. 14:00"
            android:textSize="14sp"
            android:textColor="@color/textColorPrimary"
            android:padding="3dp"/>

        <TextView
            android:id="@+id/shopServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: "
            android:textSize="14sp"
            android:textColor="@color/textColorPrimary"
            android:padding="3dp"/>

        <TextView
            android:id="@+id/shopPaymentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Način plačanja: "
            android:textSize="14sp"
            android:textColor="@color/textColorPrimary"
            android:padding="3dp"/>

        <Button
            android:id="@+id/shopServiceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detaljan pregled"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accentColor"
            android:layout_marginTop="2dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/slikaReklama"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/shop_reklama" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
