<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:cardCornerRadius="8dp"
    android:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/shopServiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Narudžba"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/shopServiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datum: 30.03.2025. 14:00"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/shopServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="14sp"/>


        <Button
            android:id="@+id/shopServiceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detaljan pregled"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
