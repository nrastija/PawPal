<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".f02_izgubljeni_pas.OdabirPrijaveIliPregledaPsaActivity">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarOdabir"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@color/secondaryColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="230dp"
            android:textAlignment="center"
            android:layout_height="wrap_content"
            android:text="Prijava ili pregled izgubljenih pasa"
            android:textSize="28dp"
            android:textStyle="bold"
            android:layout_marginLeft="75dp"
            app:layout_constraintBottom_toBottomOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintEnd_toEndOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintTop_toTopOf="@+id/toolbarIzgubljenPas"
            app:layout_constraintVertical_bias="0.698" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarOdabir">

        <Button
            android:layout_width="270dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/secondaryColor"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:text="Prijavi izgubljenog psa"
            android:textSize="25dp"
            android:layout_gravity="center"
            android:layout_marginTop="140dp"/>

        <Button
            android:layout_width="270dp"
            android:layout_height="130dp"
            android:backgroundTint="@color/secondaryColor"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:text="Pregled izgubljenih pasa"
            android:textSize="25dp"
            android:layout_gravity="center"
            android:layout_marginTop="80dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="114dp"
        android:layout_height="112dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbarOdabir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/toolbarOdabir"
        app:layout_constraintTop_toTopOf="@+id/toolbarOdabir"
        app:layout_constraintVertical_bias="0.852"
        app:srcCompat="@drawable/pronadi_psa" />
</androidx.constraintlayout.widget.ConstraintLayout>