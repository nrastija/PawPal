<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/secondaryColor">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/PasSlikaUdomljavanje"
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/zumi"
                    android:clipToOutline="true" />

                <ImageButton
                    android:id="@+id/btnNatrag"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="20dp"
                    android:padding="16dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/arrow_back_icon"
                    android:scaleType="centerInside"
                    tools:ignore="SpeakableTextPresentCheck" />
            </FrameLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_background"
            android:padding="0dp"
            android:layout_marginTop="-10dp">

            <TextView
                android:id="@+id/UdomiPasUdomljavanje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="Udomi psa!"
                android:layout_marginTop="16dp"
                android:textColor="@color/crnoubijelo"
                android:textSize="28sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ImeUdomljavanje"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Ime"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/PrezimeUdomljavanje"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Prezime"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/AdresaUdomljavanje"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/BrojTelefonaUdomljavanje"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Broj telefona"
                android:inputType="phone"
                android:padding="12dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Da li posjedujete druge kućne ljubimce?"
                android:textColor="@color/crnoubijelo"
                android:textStyle="bold"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/RadioDrugiLjubimac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/DrugiLjubimciDa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Da" />

                <RadioButton
                    android:id="@+id/DrugiLjubimciNe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ne" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Da li ste samac ili član obitelji?"
                android:textColor="@color/crnoubijelo"
                android:textStyle="bold"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/RadioClanObitelji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/Samac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samac" />

                <RadioButton
                    android:id="@+id/ClanObitelji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Član obitelji" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Da li imate iskustva sa psima?"
                android:textColor="@color/crnoubijelo"
                android:textStyle="bold"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/IskustvoSPsima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/Imam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Da, već sam bio vlasnik psa" />

                <RadioButton
                    android:id="@+id/Nemam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ne, ovo mi je prvi pas kojem sam vlasnik" />
            </RadioGroup>

            <EditText
                android:id="@+id/DodatneInfoUdomljavanje"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:hint="Zašto želite udomiti baš ovog psa?"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:background="@drawable/rounded_background"
                android:layout_marginTop="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/UdomiPsa"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/secondaryColor"
                android:padding="12dp"
                android:text="Pošalji zahtjev"
                android:textColor="@color/crnoubijelo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
