<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutProfilPsa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryColor"
    tools:context=".main.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backgroundColor">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar2"
            android:layout_width="409dp"
            android:layout_height="270dp"
            android:background="@color/secondaryColor"
            android:minHeight="?attr/actionBarSize"
            android:theme="?attr/actionBarTheme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/MojLjubimac"
            android:layout_width="244dp"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:text="Moj ljubimac"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.095"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar2" />

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/primaryColor"
            app:layout_constraintTop_toBottomOf="@id/MojLjubimac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textIme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IME:"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/podatakIme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pas ime"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="20sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textSpol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPOL:"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/podatakSpol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pas spol"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="20sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textPasmina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASMINA:"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/podatakPasmina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pasmina"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="20sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textKilaza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KILAŽA:"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/podatakKilaza"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:text="Kilaza"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textDob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOB:"
                        android:textStyle="bold"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/podatakDob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datum rođenja"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="20sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/SlikaProfila"
            android:layout_width="182dp"
            android:layout_height="191dp"
            android:layout_marginTop="52dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/toolbar2"
            app:srcCompat="@drawable/dog_profile"
            app:tint="@color/white" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarProfilPsa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/secondaryColor"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/hamburger_menu_icon"
            app:titleTextColor="@color/accentColor"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navProfilPsa"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:headerLayout="@layout/hamburger_menu_header"
        app:menu="@menu/hamburger_menu_navigacija"
        app:itemIconTint="@color/accentColor"
        app:itemTextColor="@color/accentColor"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@color/primaryColor" />

</androidx.drawerlayout.widget.DrawerLayout>
