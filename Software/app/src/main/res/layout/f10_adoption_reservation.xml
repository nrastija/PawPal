<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:cardCornerRadius="8dp"
    android:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/adoptionServiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Udomljavanje psa"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/adoptionServiceUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marko Markic"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/adoptionServiceUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mmarkic@test.com"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/adoptionServiceCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Otkazi rezervaciju"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
