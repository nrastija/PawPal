CREATE TABLE product (
    proizvodID INTEGER PRIMARY KEY AUTOINCREMENT,
    naziv TEXT NOT NULL,
    cijena REAL NOT NULL,
    opis TEXT,
    imageUrl TEXT NOT NULL,
    kategorijaId INTEGER NOT NULL,
    FOREIGN KEY (kategorijaId) REFERENCES kategorija(kategorijaID)
  );

insertProduct:
  INSERT INTO product (naziv, cijena, opis, imageUrl, kategorijaId)
  VALUES (:naziv, :cijena, :opis, :imageUrl, :kategorijaID);

getAllProducts:
  SELECT * FROM product;

getProductById:
  SELECT * FROM product
  WHERE proizvodID = :proizvodID;

getFilteredProductsByCategory:
  SELECT * FROM product
  WHERE kategorijaId = :kategorijaID;

countProcuts:
  SELECT COUNT(*) FROM product;
