CREATE TABLE narudzba (
    narudzbaID INTEGER PRIMARY KEY AUTOINCREMENT,
    korisnikId INTEGER NOT NULL,
    ukupnaCijena REAL NOT NULL,
    datum TEXT NOT NULL,
    status TEXT NOT NULL,
    nacinPlacanja TEXT NOT NULL
    ---FOREIGN KEY (korisnikId) REFERENCES korisnik(korisnikId)
    --- DODATI NAKON STO MIRTA NAPRAVI KORISNIKA
);

insertNarudzba:
INSERT INTO narudzba (korisnikId, ukupnaCijena, datum, status, nacinPlacanja)
VALUES (?, ?, ?, ?, ?);

zadnjaNarudzbaId:
SELECT last_insert_rowid() AS narudzbaId;
