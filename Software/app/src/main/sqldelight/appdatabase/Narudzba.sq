CREATE TABLE narudzba (
    narudzbaID INTEGER PRIMARY KEY AUTOINCREMENT,
    korisnikId INTEGER NOT NULL,
    ukupnaCijena REAL NOT NULL,
    datum TEXT NOT NULL,
    status TEXT NOT NULL,
    nacinPlacanja TEXT NOT NULL,
    FOREIGN KEY (korisnikId) REFERENCES korisnik(korisnikID) ON DELETE CASCADE
);

insertNarudzba:
INSERT INTO narudzba (korisnikId, ukupnaCijena, datum, status, nacinPlacanja)
VALUES (?, ?, ?, ?, ?);

dohvatiNarudzbu:
SELECT * FROM narudzba
WHERE narudzbaID = ?;

dohvatiNarudzbuPoIdKorisnika:
SELECT * FROM narudzba
WHERE korisnikId = ?;

zadnjaNarudzbaId:
SELECT last_insert_rowid() AS narudzbaId;

dohvatiUkupneTroskove:
SELECT SUM(ukupnaCijena) AS ukupno
FROM narudzba
WHERE korisnikId = ?;



dohvatiNarudzbuPoKorisniku:
SELECT narudzbaID, korisnikId, ukupnaCijena, datum, status, nacinPlacanja
FROM narudzba
WHERE korisnikId = ?;

dohvatiUkupneTroskoveSvihKorisnika:
SELECT IFNULL(SUM(ukupnaCijena), 0.0) AS ukupno
FROM narudzba;


dohvatiSveNarudzbe:
SELECT * FROM narudzba;

dohvatiBrojNarudzbiKorisnika:
SELECT COUNT(*) AS brojNarudzbi FROM narudzba WHERE korisnikId = ?;

dohvatiBrojNarudzbiSvihKorisnika:
SELECT COUNT(*) AS brojNarudzbi FROM narudzba;

