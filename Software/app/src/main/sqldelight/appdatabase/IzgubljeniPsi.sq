CREATE TABLE IzgubljeniPsi (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL,
    lastseenlocation TEXT NOT NULL,
    imageUri TEXT NOT NULL
);

dohvatiSvePse:
SELECT  * FROM IzgubljeniPsi;

unesiNovogPsa:
INSERT INTO IzgubljeniPsi(description, lastseenlocation, imageUri)
VALUES (?, ?, ?);

izbrisiPsa:
DELETE FROM IzgubljeniPsi WHERE id=?;