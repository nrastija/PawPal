CREATE TABLE korisnik (
    korisnikID INTEGER PRIMARY KEY AUTOINCREMENT,
    korime TEXT NOT NULL UNIQUE,
    ime TEXT NOT NULL,
    prezime TEXT NOT NULL,
    lozinka TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE
);

dodajKorisnik:
INSERT OR REPLACE
INTO korisnik(korime, ime, prezime, lozinka, email)
VALUES (?, ?, ?,?,?);

dajSveKorisnike:
SELECT *
FROM korisnik;

dajKorisnikaPoKorime:
SELECT *
FROM korisnik
WHERE korime = ?;

dajKorisnikaPoID:
SELECT *
FROM korisnik
WHERE korisnikID = :id;

obrisiKorisnikaPoID:
DELETE
FROM korisnik
WHERE korisnikID = :id;

obrisiKorisnikaPoKorime:
DELETE
FROM korisnik
WHERE korime = :korime;

azurirajKorisnika:
UPDATE korisnik
SET korime = :korime,
    ime = :ime,
    prezime = :prezime,
    email = :email
WHERE korisnikID = :korisnikID;

azurirajLozinku:
UPDATE korisnik
SET lozinka = :novaLozinka
WHERE korisnikID = :korisnikID;
